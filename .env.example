# Login do Google Drive (server/). Copie para .env.local e preencha; no
# Coolify, cadastre as mesmas variáveis no app, como variáveis de execução.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes aleatórios em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET=
# Origens exatas, sem barra no fim, separadas por vírgula.
OAUTH_ALLOWED_ORIGINS=http://localhost:3000
